[
  {
    "id": "office_saver",
    "name": "Office saver",
    "rules": {
      "version": 1,
      "rules": [
        {
          "label": "Occupied",
          "when": [
            {
              "type": "occupied"
            }
          ],
          "then": {
            "type": "temperature",
            "value": 21.0
          }
        },
        {
          "label": "Preheat",
          "when": [
            {
              "type": "occupied_within",
              "hours": 6.0
            }
          ],
          "then": {
            "type": "temperature",
            "value": 21.0
          }
        },
        {
          "label": "Between working days",
          "when": [
            {
              "type": "between_days",
              "gap_hours": 24.0
            }
          ],
          "then": {
            "type": "temperature",
            "value": 16.0
          }
        }
      ],
      "fallback": {
        "label": "Away",
        "then": {
          "type": "off"
        }
      }
    }
  },
  {
    "id": "lunch_room",
    "name": "Lunch room",
    "rules": {
      "version": 1,
      "rules": [
        {
          "label": "Here morning and afternoon",
          "when": [
            {
              "type": "time",
              "start": "11:00",
              "end": "14:00"
            },
            {
              "type": "planned",
              "who": "anyone",
              "match": "all",
              "windows": [
                {
                  "start": "06:00",
                  "end": "12:00"
                },
                {
                  "start": "14:00",
                  "end": "20:00"
                }
              ]
            }
          ],
          "then": {
            "type": "temperature",
            "value": 20.0
          }
        },
        {
          "label": "Here at lunch",
          "when": [
            {
              "type": "time",
              "start": "11:00",
              "end": "14:00"
            },
            {
              "type": "planned",
              "who": "anyone",
              "match": "any",
              "windows": [
                {
                  "start": "12:00",
                  "end": "14:00"
                }
              ]
            }
          ],
          "then": {
            "type": "temperature",
            "value": 20.0
          }
        },
        {
          "label": "No lunch today",
          "when": [
            {
              "type": "time",
              "start": "11:00",
              "end": "14:00"
            }
          ],
          "then": {
            "type": "off"
          }
        }
      ],
      "fallback": {
        "label": "Outside lunch hours",
        "then": {
          "type": "off"
        }
      }
    }
  },
  {
    "id": "old_building",
    "name": "Old building",
    "rules": {
      "version": 1,
      "rules": [
        {
          "label": "Occupied",
          "when": [
            {
              "type": "occupied"
            }
          ],
          "then": {
            "type": "temperature",
            "value": 20.0
          }
        },
        {
          "label": "Preheat",
          "when": [
            {
              "type": "occupied_within",
              "hours": {
                "type": "curve",
                "entity": "outdoor",
                "default": 10.0,
                "points": [
                  {
                    "at": 10.0,
                    "value": 6.0
                  },
                  {
                    "at": 20.0,
                    "value": 1.0
                  }
                ]
              }
            }
          ],
          "then": {
            "type": "temperature",
            "value": 20.0
          }
        },
        {
          "label": "Setback overnight",
          "when": [
            {
              "type": "between_days",
              "gap_hours": 16.0
            }
          ],
          "then": {
            "type": "temperature",
            "value": 15.0
          }
        }
      ],
      "fallback": {
        "label": "Away",
        "then": {
          "type": "off"
        }
      }
    }
  },
  {
    "id": "well_insulated",
    "name": "Well insulated",
    "rules": {
      "version": 1,
      "rules": [
        {
          "label": "Occupied",
          "when": [
            {
              "type": "occupied"
            }
          ],
          "then": {
            "type": "temperature",
            "value": 20.0
          }
        },
        {
          "label": "Preheat",
          "when": [
            {
              "type": "occupied_within",
              "hours": 2.0
            }
          ],
          "then": {
            "type": "temperature",
            "value": 20.0
          }
        },
        {
          "label": "Keep the heat overnight",
          "when": [
            {
              "type": "between_days",
              "gap_hours": 16.0
            }
          ],
          "then": {
            "type": "temperature",
            "value": 18.0
          }
        }
      ],
      "fallback": {
        "label": "Hold the heat",
        "then": {
          "type": "temperature",
          "value": 16.0
        }
      }
    }
  }
]
