{
  "name": "ha-share-space",
  "version": "2.8.0",
  "private": true,
  "description": "Home Assistant custom integration: share space (backend + UI components)",
  "scripts": {
    "build": "pnpm -r --filter \"./frontend/**\" --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:js": "pnpm -r --if-present test",
    "playground": "pnpm --filter ha-share-space-playground dev",
    "test:py": ".venv/bin/python -m pytest -q",
    "ha:dev": "bash scripts/start-ha-dev.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-python-versions.mjs",
    "ha:replica": "bash scripts/start-ha-replica.sh",
    "test:e2e": "pnpm --filter ha-share-space-e2e e2e"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "vite": "^5.4.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.26.0"
}
